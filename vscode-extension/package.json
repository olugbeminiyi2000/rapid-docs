{
  "name": "rapid-docs-vscode",
  "displayName": "rapid-docs",
  "description": "AST-based, git-native documentation drift detection, inside the editor.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished", "onWebviewPanel:rapidDocsCompose"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rapidDocs.helloWorld",
        "title": "rapid-docs: Hello World"
      },
      {
        "command": "rapidDocs.testBackend",
        "title": "rapid-docs: Test Backend (GitService)"
      },
      {
        "command": "rapidDocs.testReconcile",
        "title": "rapid-docs: Test Reconcile (Sync/Ast/Documentation)"
      },
      {
        "command": "rapidDocs.testLiveWatch",
        "title": "rapid-docs: Test Live Watch (LiveWatchService)"
      },
      {
        "command": "rapidDocs.testDiagnostics",
        "title": "rapid-docs: Test Diagnostics (Problems panel)"
      },
      {
        "command": "rapidDocs.testWriteDoc",
        "title": "rapid-docs: Test Write Doc (writes a real record for the current selection)"
      },
      {
        "command": "rapidDocs.testDecorations",
        "title": "rapid-docs: Test Decorations (highlight documented regions)"
      },
      {
        "command": "rapidDocs.testAstService",
        "title": "rapid-docs: Test AstService (Section 2)"
      },
      {
        "command": "rapidDocs.testGitService",
        "title": "rapid-docs: Test GitService (Section 3)"
      },
      {
        "command": "rapidDocs.testDocumentationService",
        "title": "rapid-docs: Test DocumentationService (Section 4)"
      },
      {
        "command": "rapidDocs.testSyncService",
        "title": "rapid-docs: Test SyncService (Section 5)"
      },
      {
        "command": "rapidDocs.testLiveWatchSection",
        "title": "rapid-docs: Test LiveWatchService (Section 6)"
      },
      {
        "command": "rapidDocs.openCompose",
        "title": "rapid-docs: Document selection"
      },
      {
        "command": "rapidDocs.showDocumentedSections",
        "title": "rapid-docs: Show Documented Sections"
      },
      {
        "command": "rapidDocs.showArchive",
        "title": "rapid-docs: Show Archive"
      },
      {
        "command": "rapidDocs.showEditorActions",
        "title": "rapid-docs: Actions..."
      },
      {
        "command": "rapidDocs.deleteStaleRecordFromDiagnostic",
        "title": "rapid-docs: Delete stale documentation"
      },
      {
        "command": "rapidDocsDocumentedSections.focus",
        "title": "rapid-docs: Focus on Documented Sections View"
      },
      {
        "command": "rapidDocsArchive.focus",
        "title": "rapid-docs: Focus on Archive View"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "rapidDocs.showEditorActions",
          "when": "editorTextFocus",
          "group": "rapidDocs@1"
        }
      ],
      "commandPalette": [
        { "command": "rapidDocs.helloWorld", "when": "false" },
        { "command": "rapidDocs.testBackend", "when": "false" },
        { "command": "rapidDocs.testReconcile", "when": "false" },
        { "command": "rapidDocs.testLiveWatch", "when": "false" },
        { "command": "rapidDocs.testDiagnostics", "when": "false" },
        { "command": "rapidDocs.testWriteDoc", "when": "false" },
        { "command": "rapidDocs.testDecorations", "when": "false" },
        { "command": "rapidDocs.testAstService", "when": "false" },
        { "command": "rapidDocs.testGitService", "when": "false" },
        { "command": "rapidDocs.testDocumentationService", "when": "false" },
        { "command": "rapidDocs.testSyncService", "when": "false" },
        { "command": "rapidDocs.testLiveWatchSection", "when": "false" },
        { "command": "rapidDocs.deleteStaleRecordFromDiagnostic", "when": "false" },
        { "command": "rapidDocsDocumentedSections.focus", "when": "false" },
        { "command": "rapidDocsArchive.focus", "when": "false" }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rapidDocs",
          "title": "rapid-docs",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "rapidDocs": [
        {
          "id": "rapidDocsDocumentedSections",
          "name": "Documented Sections",
          "type": "webview"
        },
        {
          "id": "rapidDocsArchive",
          "name": "Archive",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
